---
import { render } from 'astro:content';
import ExampleMark from '../../components/ExampleMark.astro';
import Prose from '../../layouts/Prose.astro';
import { getNotes } from '../../lib/content';
import { formatDot, isoDate } from '../../lib/dates';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { title, description, date, example } = note.data;
const { Content } = await render(note);
---

<Prose title={title} description={description} current="notes">
  <article>
    <header class="article-head">
      <h1>{title}<ExampleMark show={example} /></h1>
      <p class="article-date"><time datetime={isoDate(date)}>{formatDot(date)}</time></p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <p class="back"><a href={url('/notes/')}>글 목록으로</a></p>
</Prose>
